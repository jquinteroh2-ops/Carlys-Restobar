# Copie este archivo a .env.local para desarrollo. El .env real no se versiona.
#
# Solo las variables que empiezan por VITE_ llegan al navegador, y todas quedan
# escritas en el paquete compilado: aquí nunca va un secreto.

# URL del API, sin barra final.
VITE_URL_API=http://localhost:8080

# URL del WebSocket. Si se omite, se deduce de la del API cambiando el esquema
# (http->ws, https->wss), que es lo correcto en casi todos los despliegues.
# VITE_URL_WS=ws://localhost:8080/ws

# Si Carly’s emite documentos fiscales por su cuenta.
#
# Apagada, y asi debe quedarse mientras no se defina quien factura:
# dos sistemas emitiendo contra el mismo NIT es peor que ninguno. Carly’s cobra
# y entrega comprobante interno; el documento fiscal lo emite el sistema contable.
#
# Solo se pone en 'true' si el restaurante decide volver a facturar desde aqui,
# y entonces hay que llenar ademas la resolucion en src/compartido/config.ts.
VITE_FACTURACION_INTERNA_HABILITADA=false

# URL del sistema de la sede de Arjona. Sin barra final.
#
# Con esto puesto, el panel administrativo pinta arriba un selector que lleva al
# panel de la otra sede, a la misma seccion en la que se este. Sin esto, el
# selector no aparece.
#
# HOY SE DEJA COMENTADA: solo esta montada la sede de Turbaco, y un boton que
# lleva a una direccion muerta es peor que no tenerlo. El dia que Arjona exista,
# se pone aqui el dominio real de su frontend.
# VITE_URL_SEDE_HERMANA=https://carlys-arjona.up.railway.app
