# Copie este archivo a .env y ajuste los valores. El .env real NO se versiona.
#
# En Railway estas mismas variables se definen en el panel del servicio; aquí
# solo están los valores de la máquina de desarrollo.

# Base de datos. El 5435 es el puerto del contenedor de docker-compose.yml.
DATABASE_URL=jdbc:postgresql://localhost:5435/carlys
DATABASE_USUARIO=carlys
DATABASE_CLAVE=carlys

# Firma de los tokens. Mínimo 32 caracteres: con menos, el backend no arranca.
# Genere uno propio para cada entorno, por ejemplo con:
#   openssl rand -base64 48
CARLYS_JWT_SECRETO=cambie-este-secreto-por-uno-aleatorio-de-al-menos-32-caracteres

# Orígenes autorizados, separados por comas. Nunca `*`.
CARLYS_CORS_ORIGENES=http://localhost:5173

# Modo demostración: siete cuentas (admin, mesero, mesero2, cocina, recepcion,
# repartidor, cajero) con esta misma clave, escritas en la pantalla de acceso,
# y casi un mes de ventas de ejemplo. En local se deja encendido para poder
# enseñar el sistema; en producción esta línea NO va.
CARLYS_CLAVE_DEMO=carlys2026

# Zona en la que se calculan el día operativo y el turno.
CARLYS_ZONA=America/Bogota

# --- Integraciones (todas opcionales: vacías = la función queda inactiva) ---

# Anticipos con Wompi. Vacío = sandbox sin llaves reales.
CARLYS_WOMPI_URL_BASE=https://sandbox.wompi.co/v1
CARLYS_WOMPI_LLAVE_PRIVADA=
CARLYS_WOMPI_SECRETO_EVENTOS=

